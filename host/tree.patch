+/* A kept module path: relative, no part empty, "." or "..", plain ASCII, no ':'. */
+static int path_form_ok(const char *p)
+{
+    size_t n = strlen(p), start = 0;
+    for (size_t i = 0; i <= n; i++) {
+        if (p[i] && p[i] != '/' && p[i] != '\\') {
+            if ((unsigned char)p[i] < 0x20 || (unsigned char)p[i] > 0x7E || p[i] == ':')

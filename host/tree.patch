+/* main21 patch 136: which source the next song of the mix comes from: 0 EA GAMES TRAX, n soundtrack n - 1, each weighted by its songs, so
+ * every song of the pool is as likely. counts[i]: soundtrack i's songs; n_ea: EA GAMES TRAX's (0: not in the pool). -1: an empty pool. */
+static inline int32_t bo3_mix_pick(const int *counts, int n_st, int n_ea, uint32_t rnd)
+{
+    uint32_t total = n_ea > 0 ? (uint32_t)n_ea : 0u, r;
+    int i;
+    for (i = 0; i < n_st; i++)
+        if (counts[i] > 0)
+            total += (uint32_t)counts[i];
+    if (!total)
+        return -1;
+    r = rnd % total;
+    if (n_ea > 0) {
+        if (r < (uint32_t)n_ea)
+            return 0;
+        r -= (uint32_t)n_ea;
+    }
+    for (i = 0; i < n_st; i++)
+        if (counts[i] > 0) {
+            if (r < (uint32_t)counts[i])
+                return i + 1;
+            r -= (uint32_t)counts[i];
+        }
+    return -1;
+}

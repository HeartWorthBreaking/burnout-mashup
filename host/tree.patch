+#ifndef P1_MUT
+#define P1_MUT 0     /* tests only: one deliberate defect (tests\test_p1_platform.c) */
+#endif
+
+/* PLATFORM-P1 (P-6): the end of a folder path, where its mod set and mod folder names are. */
+static const char *path_tail(const char *s, size_t n, const char **dots)
+{
+    size_t l = strlen(s);
+    *dots = l > n ? "..." : "";
+    return l > n ? s + l - n : s;
+}
+
+/* PLATFORM-P3 (P-9): the admission list_mods calls (bm_admit.c in the game; none in the unit tests) */
+static bo3_modfs_admit_fn s_admit;
+
+void bo3_modfs_set_admit(bo3_modfs_admit_fn fn)
+{
+    s_admit = fn;
+}
+
+static void list_mods(void)
+{
+    /* A shared id refuses every copy: no order decides which one is used. PLATFORM-P1 (P-6): one log line names both
+     * folders in full with their TAKEDAWN_MODS folder numbers (the mod sets); each copy's reason names the other's
+     * folder by its END (set\mod), where a long path used to be cut. */
+    for (int i = 0; i < s_nmods; i++)
+        for (int j = i + 1; j < s_nmods; j++)
+            if (s_mods[i].manifest.id[0] && !strcmp(s_mods[i].manifest.id, s_mods[j].manifest.id)) {
+                const char *d;
+                const char *t;
+#if P1_MUT != 9                                 /* P1_MUT 9, defect: no line naming both folders */
+                XR_NOTICE("[MOD] id %s is used by two mod folders, so neither is used: %s (mod folder %d) and %s (mod "
+                          "folder %d); give one of them another id, or remove one\n", s_mods[i].manifest.id,
+                          s_mods[i].folder, s_mods[i].root + 1, s_mods[j].folder, s_mods[j].root + 1);
+#endif
+                if (s_mods[i].usable) {
+                    t = path_tail(s_mods[j].folder, 70, &d);
+                    snprintf(s_mods[i].problem, sizeof s_mods[i].problem, "id %.64s is also used by %s%s",
+                             s_mods[i].manifest.id, d, t);
+                }
+                if (s_mods[j].usable) {
+                    t = path_tail(s_mods[i].folder, 70, &d);
+                    snprintf(s_mods[j].problem, sizeof s_mods[j].problem, "id %.64s is also used by %s%s",
+                             s_mods[j].manifest.id, d, t);
+                }
+                s_mods[i].usable = s_mods[j].usable = 0;
+            }
+    qsort(s_mods, (size_t)s_nmods, sizeof s_mods[0], by_root_then_id);
+    for (int i = 0; i < s_nmods; i++)
+        s_mods[i].enabled = !is_off(s_mods[i].manifest.id);
+    if (s_admit)                                /* PLATFORM-P3 (P-9): before any source, service or plugin sees a mod */
+        s_admit(s_mods, s_nmods);
+    s_nsrc = 0;
+    for (int r = 0; r < s_ndirs; r++) {
+        if (s_dup[r])
+            continue;   /* taken once, in its first place: its files and mods are there */
+        s_src[s_nsrc].root = r;
+        s_src[s_nsrc].mod = -1;
+        s_src[s_nsrc].listed = 0;
+        s_src[s_nsrc].files = NULL;
+        s_src[s_nsrc].nfiles = 0;
+        s_src[s_nsrc].prefix[0] = 0;
+        index_loose(&s_src[s_nsrc++]);      /* main18: a lookup searches the list, not the disk */
+        for (int i = 0; i < s_nmods; i++) {
+            if (s_mods[i].root != r)
+                continue;
+            if (s_mods[i].usable) {
+                if (s_mods[i].enabled)
+                    add_mod_source(r, i);
+                XR_NOTICE("[MOD] mod %s%s%s: %s%s\n", s_mods[i].manifest.id, s_mods[i].manifest.version[0] ? " " : "",
+                          s_mods[i].manifest.version, s_mods[i].folder, s_mods[i].enabled ? "" : " (off)");
+            } else {
+                XR_NOTICE("[MOD] mod ignored (%s): %s\n", s_mods[i].problem, s_mods[i].folder);
+            }
+        }
+    }
+}
+
+/* main18: the loose files of folder s->root, listed once at the start like a mod's files (so 256 folders cost a search
+ * each per file open, not a walk each): every file below the folder except the mod subfolders' (a mod's own files are
+ * reached through its files/ only). More than MODFS_INDEX_FILES files, folders deeper than MODFS_INDEX_DEPTH, or out of
+ * memory: no list, the folder is walked for every path (capmega1's behaviour for every loose folder). A file put into a
+ * loose folder after the start is not seen until the next start (as a mod's files). */
+static int is_mod_sub(int r, const char *rel);
+static void index_loose(source *s)
+{
+    file_list l = { 0 };
+    int k = 0;
+#if MODFS_MUT == 1
+    return;                                 /* defect (tests): loose folders never listed, walked for every lookup */
+#endif
+    index_mod(s->root, "", &l);
+    if (l.incomplete) {
+        list_free(l.v, l.n);
+        XR_NOTICE("[MOD] folder %d: no list of its loose files (more than %d files, folders more than %d deep, or out of "
+                  "memory): looked up on disk for every file\n", s->root + 1, MODFS_INDEX_FILES, MODFS_INDEX_DEPTH);
+        return;
+    }
+    for (int i = 0; i < l.n; i++) {
+#if MODFS_MUT != 2
+        if (is_mod_sub(s->root, l.v[i])) {  /* (MODFS_MUT 2, defect: a mod's own folder listed as loose files) */
+            free(l.v[i]);
+            continue;
+        }
+#endif
+        l.v[k++] = l.v[i];
+    }
+    if (k)
+        qsort(l.v, (size_t)k, sizeof *l.v, by_string);
+    s->listed = 1;
+    s->files = l.v;
+    s->nfiles = k;
+}
+
+/* rel's first part names a mod subfolder of folder r: not one of its loose
+ * files (a mod's own files are reached through its files/ only). */
+static int is_mod_sub(int r, const char *rel)
+{
+    size_t n = strcspn(rel, "\\/");
+    for (int i = 0; i < s_nmods; i++) {
+        const char *sub = mod_sub(&s_mods[i]);
+        if (s_mods[i].root == r && strlen(sub) == n) {
+            size_t k = 0;
+            while (k < n && ascii_lower((unsigned char)sub[k]) == ascii_lower((unsigned char)rel[k]))
+                k++;
+            if (k == n)
+                return 1;
+        }
+    }
+    return 0;
+}
+
+/* ── Conflicts: files more than one source has ──────────────────────────
+ * Found once, at the start, for the log and the counts in bo3_mod: the files
+ * of the enabled mods' lists, each looked for in every source in lookup
+ * order, with the walk a lookup makes; the first one that has it is the one
+ * used, as in redirect. Over MODFS_CONFLICT_WALK different files, nothing is
+ * walked: mods with a list are compared by their lists alone, the others not.
+ * Files that no enabled mod's list has are not looked at: two loose folders,
+ * or a loose folder and a mod without a list, with the same file are not
+ * told. */
+#define MODFS_CONFLICT_WALK 1024
+#define MODFS_CONFLICT_LINES 32
+
+static int s_nconf;
+
+/* Whether a lookup of key would be answered by s: its list says so first,
+ * then the walk redirect makes decides (a listed file can still be refused:
+ * a path too long, names that differ only in case). walk 0: the list only. */
+static int source_has(const source *s, const char *key, int walk, int *ambiguous)
+{
+    char q[MAX_PATH + MODFS_NAME_MAX + 8], host[MAX_PATH];
+
+    *ambiguous = 0;
+    if (s->listed && (!s->nfiles || !bsearch(&key, s->files, (size_t)s->nfiles, sizeof *s->files, by_string)))
+        return 0;
+    if (s->listed && !walk)
+        return 1;
+    if (s->mod < 0 ? is_mod_sub(s->root, key) || snprintf(q, sizeof q, "%s", key) >= (int)sizeof q
+                   : snprintf(q, sizeof q, "%s/%s", s->prefix, key) >= (int)sizeof q)
+        return 0;
+    return mod_file(s_dirs[s->root], q, host, MODFS_HOST_MAX, ambiguous);
+}
+
+static void source_name(const source *s, char *out, size_t n)
+{
+    if (s->mod < 0)
+        snprintf(out, n, "folder %d", s->root + 1);
+    else
+        snprintf(out, n, "mod %s", s_mods[s->mod].manifest.id);
+}

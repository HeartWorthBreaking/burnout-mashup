+        if (k < 4) {
+            if (!bo3_modfs_set_enabled(ids[k], i & 1))
+                s_toggle_bad[k]++;
+        } else if (strcmp(read_back("D:\\Data\\x.bin"), "one") != 0) {
+            s_toggle_bad[k]++;   /* this session does not change */
+        }
+    }
+}

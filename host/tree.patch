+# pfid1 (public-fork identity): BMASHUP_IDENTITY=ON (default) gives the host the Burnout Mashup names, folders
+# (%APPDATA%\BurnoutMashup, %LOCALAPPDATA%\BurnoutMashup), window title, icon / version resource, diagnostics names and
+# BMASHUP_* environment aliases (TAKEDAWN_* still read), never moves the old-name folders, and has NO update row unless
+# BMASHUP_UPDATE_REPO names a verified Burnout Mashup release channel. OFF = the main21 (Takedawn) identity, the single revert
+# switch. Plugin ABI (takedawn_* headers, host_version 0.2.1) is the same either way.
+option(BMASHUP_IDENTITY "pfid1: Burnout Mashup names, folders and update identity (OFF = main21 / Takedawn identity)" ON)
+set(BMASHUP_UPDATE_REPO "" CACHE STRING "pfid1: owner/repo of a VERIFIED Burnout Mashup release channel (empty = no update row, no request)")
+set(BMASHUP_UPDATE_VERSION "" CACHE STRING "pfid1: the Burnout Mashup version the update channel's latest tag is compared with")
+if(BMASHUP_IDENTITY)
+    add_compile_definitions(BMASHUP_IDENTITY=1)
+    if(NOT BMASHUP_UPDATE_REPO STREQUAL "")
+        if(NOT BMASHUP_UPDATE_REPO MATCHES "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
+            message(FATAL_ERROR "BMASHUP_UPDATE_REPO must be owner/repo, got '${BMASHUP_UPDATE_REPO}'")
+        endif()
+        if(BMASHUP_UPDATE_REPO MATCHES "^[Xx]enophobentx/")
+            message(FATAL_ERROR "BMASHUP_UPDATE_REPO must be a Burnout Mashup channel, not the upstream Takedawn repository")
+        endif()
+        if(NOT BMASHUP_UPDATE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+")
+            message(FATAL_ERROR "BMASHUP_UPDATE_REPO needs BMASHUP_UPDATE_VERSION (the Mashup version, e.g. 0.7.0)")
+        endif()
+        add_compile_definitions("BMASHUP_UPDATE_REPO=\"${BMASHUP_UPDATE_REPO}\"" "BMASHUP_UPDATE_VERSION=\"${BMASHUP_UPDATE_VERSION}\"")
+        message(STATUS "Burnout Mashup: update channel ${BMASHUP_UPDATE_REPO} (compared with ${BMASHUP_UPDATE_VERSION})")
+    else()
+        message(STATUS "Burnout Mashup identity ON: no update row (BMASHUP_UPDATE_REPO empty)")
+    endif()
+else()
+    message(STATUS "Burnout Mashup identity OFF (BMASHUP_IDENTITY=OFF): main21 / Takedawn names and folders")
+endif()

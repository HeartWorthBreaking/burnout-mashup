+            continue;
+        len = i - start;
+        if (len == 0 || (len == 1 && v[start] == '.') || (len == 2 && v[start] == '.' && v[start + 1] == '.')
+                || v[i - 1] == '.' || v[i - 1] == ' ') {
+            snprintf(why, wn, "plugin.%s: a part of the path is empty, . or .., or ends in a dot or a space",

+ * file's order (the first folder named still wins). For more or longer paths than one environment value holds (Windows:
+ * 32,767 characters). At most MODFS_FOLDERS_FILE_MAX bytes; a line of MAX_PATH characters or more is skipped (logged). */
+#define MODFS_FOLDERS_FILE_MAX (1024 * 1024)
+/* The list file's bytes (its own reader, so this item does not depend on the mod list's): 1 read, 0 no such file, -1 not
+ * readable now, -2 not a plain file or larger than MODFS_FOLDERS_FILE_MAX. */
+static int folders_file_read(const char *path, char **text, size_t *n)
+{
+    FILE *f;
+    long len;
+#if defined(_WIN32)
+    wchar_t w[MODFS_STATE_PATH + 8];
+    DWORD at;
+    if (!widen(path, w))
+        return -1;
+    at = GetFileAttributesW(w);
+    if (at == INVALID_FILE_ATTRIBUTES)
+        return GetLastError() == ERROR_FILE_NOT_FOUND || GetLastError() == ERROR_PATH_NOT_FOUND ? 0 : -1;
+    if (at & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DEVICE))
+        return -2;
+    f = _wfopen(w, L"rb");
+#else
+    struct stat st;
+    if (stat(path, &st) != 0)
+        return errno == ENOENT || errno == ENOTDIR ? 0 : -1;
+    if (!S_ISREG(st.st_mode))
+        return -2;
+    f = fopen(path, "rb");
+#endif
+    *text = NULL;
+    *n = 0;
+    if (!f)
+        return -1;
+    if (fseek(f, 0, SEEK_END) != 0 || (len = ftell(f)) < 0 || fseek(f, 0, SEEK_SET) != 0) {
+        fclose(f);
+        return -1;
+    }
+    if (len > MODFS_FOLDERS_FILE_MAX) {
+        fclose(f);
+        return -2;
+    }
+    *text = malloc((size_t)len + 1);
+    if (!*text) {
+        fclose(f);
+        return -1;
+    }
+    *n = fread(*text, 1, (size_t)len, f);
+    fclose(f);
+    return *n == (size_t)len ? 1 : -1;

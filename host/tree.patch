+# MEM256 (gp slice mem256, owner 2026-10-28 "Go to 256mb directly"): the size of the guest's contiguous window at
+# 0x80000000, in MB. ONE switch for every mem256 change (gp\slices\mem256\MEM256_STEPS.md): 64 = capmega1's memory
+# behaviour (no definition is passed, every mem256 code path compiles out); 256 = the 256 MB window (low 64 MB unchanged,
+# host expansions in the high zone 64..256 MB, NV2A backend compares 28-bit, APU / OHCI / bm_guest by the full window,
+# the boot budget gate and the fail-fast on a refused game allocation). The toolkit and the game read the same macro.
+set(BO3_GUEST_WINDOW_MB 256 CACHE STRING "Guest contiguous window in MB: 64 (capmega1 behaviour) or 256 (mem256)")
+set_property(CACHE BO3_GUEST_WINDOW_MB PROPERTY STRINGS 64 256)
+if(NOT BO3_GUEST_WINDOW_MB STREQUAL "64" AND NOT BO3_GUEST_WINDOW_MB STREQUAL "256")
+    message(FATAL_ERROR "BO3_GUEST_WINDOW_MB must be 64 or 256 (got '${BO3_GUEST_WINDOW_MB}')")
+endif()
+if(NOT BO3_GUEST_WINDOW_MB STREQUAL "64")
+    add_compile_definitions(XBOX_CONTIG_WINDOW_MB=${BO3_GUEST_WINDOW_MB})
+endif()

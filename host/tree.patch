+# PLATFORM-P2: a reproducible build - the same sources, toolchain and configuration give the same bytes in any build
+# folder. No absolute source or build path in the objects (-ffile-prefix-map: __FILE__ and debug info name bmp/...,
+# xboxrecomp/..., build/...), and one fixed date for __DATE__ / __TIME__ (SOURCE_DATE_EPOCH, given to every C / C++
+# compile through the compiler launcher; clang reads it): the toolkit's bug report still prints a "built" date. The
+# executable's link time stamp is left out in src/game/CMakeLists.txt. The build identity: cmake/bo3_source_id.cmake.
+option(BO3_REPRODUCIBLE "Reproducible build: path prefix maps, a fixed SOURCE_DATE_EPOCH, no PE time stamp" ON)
+if(DEFINED ENV{SOURCE_DATE_EPOCH} AND NOT "$ENV{SOURCE_DATE_EPOCH}" STREQUAL "")
+    set(_bo3_sde "$ENV{SOURCE_DATE_EPOCH}")
+else()
+    set(_bo3_sde 1792972800)          # 2026-10-26 00:00:00 UTC (platform host p2)
+endif()
+set(BO3_SOURCE_DATE_EPOCH "${_bo3_sde}" CACHE STRING "Seconds since 1970 that __DATE__ / __TIME__ name (BO3_REPRODUCIBLE)")
+if(BO3_REPRODUCIBLE AND NOT MSVC)
+    get_filename_component(_bo3_xr_abs "${XBOXRECOMP_DIR}" ABSOLUTE)
+    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${CMAKE_SOURCE_DIR}=bmp>")
+    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${_bo3_xr_abs}=xboxrecomp>")
+    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${CMAKE_BINARY_DIR}=build>")
+    # Objects without the COFF time stamp too (the linker ignores it; byte-equal objects make the audits exact).
+    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-mno-incremental-linker-compatible>")
+    foreach(_bo3_lang C CXX)
+        set(_bo3_launch "${CMAKE_COMMAND}" -E env "SOURCE_DATE_EPOCH=${BO3_SOURCE_DATE_EPOCH}")
+        if(CMAKE_${_bo3_lang}_COMPILER_LAUNCHER)
+            list(APPEND _bo3_launch ${CMAKE_${_bo3_lang}_COMPILER_LAUNCHER})
+        endif()
+        set(CMAKE_${_bo3_lang}_COMPILER_LAUNCHER ${_bo3_launch})
+    endforeach()
+endif()
 

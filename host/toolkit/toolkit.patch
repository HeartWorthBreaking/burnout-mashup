+ * model; the overlay asks for it every frame it draws, on its own thread with
+ * its lock held (the title is paused once the overlay has opened), and never
+ * keeps a pointer past the call.
+ *   rows(page)            the number of rows now (0..XBOX_PORT_ROWS)
+ *   row(page, i, out)     row i, into *out (zeroed before the call)
+ *   input(page, i, act)   an XBOX_PA_* on row i (i -1: the page has no
+ *                         selectable row); returns XBOX_PI_* bits
+ *   cursor(page)          after XBOX_PI_VIEW: the row to put the cursor on
+ *                         (-1 the first selectable)
+ *   name(page)            the tab's name (stable; the overlay capitalises it)
+ *   crumb(page)           the header's page name now (NULL: name(page))
+ *   prompt(page, i, b)    the footer's word for button b (XBOX_PB_*) on row i,
+ *                         NULL or "" when b does nothing there
+ *   restart(why, n)       how many of the port's changes wait for a restart,
+ *                         the reason into why (counted in "Restart now to
+ *                         apply N changes", besides xbox_OverlayWantRestart's)
+ * A label longer than its column scrolls on the selected row; an
+ * XBOX_PR_TEXT row is a paragraph, wrapped to the page's width. */
+#define XBOX_PORT_PAGES 2
+#define XBOX_PORT_ROWS 1024
+enum { XBOX_PR_ITEM = 0,   /* selectable: label, value (a chip or a choice), hint */
+       XBOX_PR_HEADER,     /* a section's name, not selectable */
+       XBOX_PR_TEXT,       /* a paragraph (label), wrapped; not selectable */
+       XBOX_PR_INFO };     /* one line of small text (label), not selectable */
+enum { XBOX_PT_PLAIN = 0, XBOX_PT_DIM, XBOX_PT_ATTN, XBOX_PT_BAD, XBOX_PT_GOOD };   /* a value's or a label's tone */
+#define XBOX_PRF_NOCAPS  1u        /* the label as written (a name), not in the game's capitals */
+#define XBOX_PRF_CHOICE  2u        /* the value is a choice: arrows beside it on the selected row */
+#define XBOX_PRF_ACTION  4u        /* an action: the label in the actions' colour, no value box */
+#define XBOX_PRF_LOCKED  8u        /* the padlock where the left arrow would be */
+typedef struct xbox_port_row {
+    int kind;                      /* XBOX_PR_* */
+    unsigned flags;                /* XBOX_PRF_* */
+    int tone;                      /* the value's tone (XBOX_PR_ITEM), the label's (the others) */
+    char label[256];               /* UTF-8 */
+    char value[64];                /* "" none */
+    char hint[1024];               /* shown under the rows while the row is selected */
+} xbox_port_row;
+enum { XBOX_PA_OPEN = -1,        /* (row -1) the overlay opens on the page from the port's call: its top view */
+       XBOX_PA_SELECT = 0, XBOX_PA_LEFT, XBOX_PA_RIGHT, XBOX_PA_X, XBOX_PA_DEFAULT, XBOX_PA_BACK };

+/* -- xst_read_tags (main21 patch 135): the title, artist and album a song's banner shows -------------------------------- */
+typedef struct { char *title, *artist, *album; size_t cap; } tag_out;
+
+static void id3v2_tags(FILE *f, const tag_out *o)
+{
+    uint8_t h[10], *tag;
+    uint32_t size, pos = 0;
+    int ver;
+
+    if (fseek(f, 0, SEEK_SET) != 0 || fread(h, 1, 10, f) != 10 || memcmp(h, "ID3", 3))
+        return;
+    ver = h[3];
+    size = syncsafe(h + 6);
+    if (ver < 2 || ver > 4 || size == 0 || (h[5] & 0x80))
+        return;
+    if (size > 65536)                             /* the text frames come first (id3v2_title) */
+        size = 65536;
+    tag = (uint8_t *)malloc(size);
+    if (!tag)
+        return;
+    if (fread(tag, 1, size, f) != size) {
+        free(tag);
+        return;
+    }
+    if (ver >= 3 && (h[5] & 0x40) && size >= 4)
+        pos = ver == 4 ? syncsafe(tag) : be32(tag) + 4;
+    for (;;) {
+        uint32_t fsize, hdr = ver == 2 ? 6 : 10;
+        char *to = NULL;
+        if (pos > size || hdr > size - pos || tag[pos] == 0)
+            break;
+        if (ver == 2) {
+            fsize = (uint32_t)tag[pos + 3] << 16 | (uint32_t)tag[pos + 4] << 8 | tag[pos + 5];
+            to = !memcmp(tag + pos, "TT2", 3) ? o->title : !memcmp(tag + pos, "TP1", 3) ? o->artist : !memcmp(tag + pos, "TAL", 3) ? o->album : NULL;
+        } else {
+            fsize = ver == 4 ? syncsafe(tag + pos + 4) : be32(tag + pos + 4);
+            to = !memcmp(tag + pos, "TIT2", 4) ? o->title : !memcmp(tag + pos, "TPE1", 4) ? o->artist : !memcmp(tag + pos, "TALB", 4) ? o->album : NULL;
+        }
+        if (fsize > size - pos - hdr)
+            break;
+        if (to && !to[0])
+            id3_text(tag + pos + hdr, fsize, to, o->cap);
+        pos += hdr + fsize;
+    }
+    free(tag);
+}
+
+/* ISO 8859-1, space or NUL padded */
+static void id3v1_field(const uint8_t *b, size_t len, char *out, size_t cap)
+{
+    size_t i, n = 0;
+    while (len > 0 && (b[len - 1] == ' ' || b[len - 1] == 0))
+        len--;
+    if (out[0] || !cap)
+        return;
+    for (i = 0; i < len && b[i] && n + 3 < cap; i++)
+        n = utf8_put(out, n, cap, b[i]);
+    out[n] = 0;
+}
+
+static void id3v1_tags(FILE *f, const tag_out *o)
+{
+    uint8_t t[128];
+    if (fseek(f, -128, SEEK_END) != 0 || fread(t, 1, 128, f) != 128 || memcmp(t, "TAG", 3))
+        return;
+    id3v1_field(t + 3, 30, o->title, o->cap);
+    id3v1_field(t + 33, 30, o->artist, o->cap);
+    id3v1_field(t + 63, 30, o->album, o->cap);
+}
+
+/* "NAME=value": the value into its slot, if the slot is still empty */
+static void comment_tag(const char *c, size_t n, const tag_out *o)
+{
+    static const char *const names[3] = {"TITLE=", "ARTIST=", "ALBUM="};
+    char *const to[3] = {o->title, o->artist, o->album};
+    int i;
+    for (i = 0; i < 3; i++) {
+        size_t k = strlen(names[i]), j;
+        if (n < k || to[i][0])
+            continue;
+        for (j = 0; j < k; j++)
+            if (toupper((unsigned char)c[j]) != (unsigned char)names[i][j])
+                break;
+        if (j == k) {
+            copy_text(to[i], o->cap, c + k, n - k);
+            return;
+        }
+    }
+}
+
+static void flac_tags(void *user, drflac_metadata *m)
+{
+    drflac_vorbis_comment_iterator it;
+    const char *c;
+    drflac_uint32 n;
+    if (m->type != DRFLAC_METADATA_BLOCK_TYPE_VORBIS_COMMENT)
+        return;
+    drflac_init_vorbis_comment_iterator(&it, m->data.vorbis_comment.commentCount, m->data.vorbis_comment.pComments);
+    while ((c = drflac_next_vorbis_comment(&it, &n)) != NULL)
+        comment_tag(c, n, (const tag_out *)user);
+}
+
+int xst_read_tags(const char *path, char *title, char *artist, char *album, size_t cap)
+{
+    tag_out o = {title, artist, album, cap};
+    if (!cap)
+        return 0;
+    title[0] = artist[0] = album[0] = 0;
+    switch (kind_of(path)) {
+    case K_MP3: {
+        FILE *f = open_file(path);
+        if (f) {
+            id3v2_tags(f, &o);
+            id3v1_tags(f, &o);
+            fclose(f);
+        }
+        break;
+    }
+    case K_FLAC: {
+        drflac *fl;
+#ifdef _WIN32
+        wchar_t w[1024];
+        fl = wide_path(path, w, 1024) ? drflac_open_file_with_metadata_w(w, flac_tags, &o, NULL) : NULL;
+#else
+        fl = drflac_open_file_with_metadata(path, flac_tags, &o, NULL);
+#endif
+        if (fl)
+            drflac_close(fl);
+        break;
+    }
+    case K_OGG: {
+        stb_vorbis *v = ogg_open(path);
+        if (v) {
+            stb_vorbis_comment c = stb_vorbis_get_comment(v);
+            int i;
+            for (i = 0; i < c.comment_list_length; i++)
+                comment_tag(c.comment_list[i], strlen(c.comment_list[i]), &o);
+            stb_vorbis_close(v);
+        }
+        break;
+    }
+    default:
+        break;
+    }
+    return title[0] || artist[0] || album[0];
+}

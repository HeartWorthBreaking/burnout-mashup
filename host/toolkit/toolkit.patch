+/* A label in w, always at the row's size: whole when it fits, else on the
+ * selected row scrolling (a second's hold, along at three letters' height a
+ * second, a second's hold at its end, again), on the others cut with an
+ * ellipsis. */
+static void port_label(ImDrawList *dl, float fs, ImVec2 p, ImU32 c, const char *t, float w, bool sel, uint32_t t0)
+{
+    const float full = tw(fs, t);
+    if (full <= w) {
+        txt(dl, fs, p, c, t);
+        return;
+    }
+    if (!sel) {
+        txt(dl, fs, p, c, port_ellipsis(fs, t, w));
+        return;
+    }
+    const float over = full - w, speed = fs * 3.0f;
+    const float run = over / speed * 1000.0f, cycle = 1000.0f + run + 1000.0f;
+    const float ms = fmodf((float)(now_ms() - t0), cycle);
+    const float off = ms < 1000.0f ? 0.0f : ms < 1000.0f + run ? (ms - 1000.0f) / 1000.0f * speed : over;
+    dl->PushClipRect(ImVec2(p.x - fs * 0.1f, p.y - fs * 0.2f), ImVec2(p.x + w + fs * s_shear, p.y + fs * 1.4f), true);
+    txt(dl, fs, ImVec2(p.x - off, p.y), c, t);
+    dl->PopClipRect();
+}

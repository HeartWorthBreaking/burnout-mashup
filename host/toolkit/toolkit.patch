+/* t cut with an ellipsis to fit w at size (the current face). */
+static const char *port_ellipsis(float size, const char *t, float w)
+{
+    static char b[300];
+    size_t n = strlen(t), lo = 0, hi = n;
+    if (tw(size, t) <= w)
+        return t;
+    while (lo < hi) {                           /* the longest prefix that fits with the ellipsis */
+        size_t mid = (lo + hi + 1) / 2;
+        while (mid > 0 && (t[mid] & 0xC0) == 0x80)
+            mid--;                              /* never inside a UTF-8 character */
+        snprintf(b, sizeof b, "%.*s\xE2\x80\xA6", (int)mid, t);
+        if (mid > lo && tw(size, b) <= w)
+            lo = mid;
+        else
+            hi = mid > lo ? mid - 1 : lo;
+    }
+    while (lo > 0 && t[lo - 1] == ' ')
+        lo--;
+    snprintf(b, sizeof b, "%.*s\xE2\x80\xA6", (int)lo, t);
+    return b;
+}

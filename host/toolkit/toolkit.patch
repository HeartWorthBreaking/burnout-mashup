+#define XBOX_PI_VIEW    2u         /* the rows are another view now: cursor(page), the rows come in */
+#define XBOX_PI_NONE    4u         /* nothing to do there (a short move sound) */
+#define XBOX_PI_ASK     8u         /* a question is shown (the confirm sound) */
+enum { XBOX_PB_A = 0, XBOX_PB_B, XBOX_PB_X, XBOX_PB_Y, XBOX_PB_DPAD, XBOX_PB_COUNT };
+typedef struct xbox_port_page_ops {
